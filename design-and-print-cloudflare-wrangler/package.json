{
  "name": "design-and-print-cloudflare",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev ./public",
    "deploy": "wrangler pages deploy ./public",
    "d1:create": "wrangler d1 create design-and-print-db",
    "d1:apply:remote": "wrangler d1 execute design-and-print-db --remote --file=./schema.sql",
    "d1:apply:local": "wrangler d1 execute design-and-print-db --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}